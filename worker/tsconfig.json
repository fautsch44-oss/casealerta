{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/lib/catalog-data": ["./build/catalog-data.ts"],
      "@/*": ["../site/*"]
    }
  },
  "include": ["src", "build"]
}
