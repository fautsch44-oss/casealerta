{
  "expo": {
    "name": "CaseAlerta",
    "slug": "casealerta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "casealerta",
    "userInterfaceStyle": "light",
    "owner": "vargers-team",
    "ios": {
      "bundleIdentifier": "com.vargergroup.casealerta",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserTrackingUsageDescription": "CaseAlerta nunca rastrea entre apps."
      }
    },
    "android": {
      "package": "com.vargergroup.casealerta",
      "adaptiveIcon": {
        "backgroundColor": "#0A2A6B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A2A6B",
          "image": "./assets/images/seal.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C8102E",
          "defaultChannel": "case"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
